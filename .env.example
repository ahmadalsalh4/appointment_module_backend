APP_NAME="Appointment Module"
APP_ENV=local
APP_KEY=
# APP_DEBUG should be false in production. The example defaults to false
# to avoid leaking stack traces when someone copies this file as-is.
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Europe/Istanbul

# Authentication
# Route groups always specify auth:customer / auth:staff / auth:admin
# explicitly; auth.php default falls back to 'web'.
AUTH_GUARD=
AUTH_PASSWORD_BROKER=customers

# Sanctum: comma-separated list of stateful SPA origins for cookie auth.
# The frontend SPA uses pure bearer tokens; stateful domains are kept
# here so cookie-mode works if/when we migrate.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Token lifetime in minutes. Default 12h.
SANCTUM_EXPIRATION_MINUTES=720

# CORS: comma-separated list of explicit origins. The frontend deploys
# on Netlify; preview branches use *.netlify.app which is whitelisted via
# regex in config/cors.php. Production Netlify origin and the local Vite
# dev server are listed here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://astounding-blancmange-80c978.netlify.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production deploys use Postgres on Render. Leave DB_URL unset on
# local dev if you want to use sqlite; otherwise fill in DATABASE_URL
# or the individual DB_HOST/DB_PORT/etc. fields.
DB_CONNECTION=pgsql
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=appointment_module
# DB_USERNAME=postgres
# DB_PASSWORD=

# Pin the per-connection session timezone so date-based WHERE clauses
# (whereDate, scopeOnDate) interpret stored timestamps through the
# business timezone (Europe/Istanbul) instead of the server default.
# Applied to both MySQL and Postgres connection blocks.
DB_TIMEZONE=Europe/Istanbul

# When DB_URL is present (Render auto-injects it), leave the individual
# fields above commented out. Render Postgres requires SSL.
DB_URL=
DB_SSLMODE=prefer

# Capacity knobs
DB_POOL_MIN=1
DB_POOL_MAX=10

# When true, the entrypoint will run `php artisan migrate --force` on
# container start. Set to false for manual migrations.
RUN_MIGRATIONS=true

# When true AND APP_ENV=local, the entrypoint will run `php artisan db:seed`.
# Any other combination refuses to seed.
SEED_DATABASE=false

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
